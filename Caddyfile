{
	email {$CADDY_EMAIL:hello@viserv.in}
}

# www → apex (301). Canonical / sitemap / robots / metadataBase all use https://viserv.in.
# Serving both hosts as 200 creates duplicate URLs for crawlers.
www.viserv.in {
	redir https://viserv.in{uri} permanent
}

viserv.in {
	encode gzip zstd
	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
