{
	# Until DNS for the real domain points here, keep HTTP-only (IP cannot get public TLS).
	# After DNS cutover: remove auto_https off and change the site block to {$DOMAIN}.
	auto_https off
	email {$CADDY_EMAIL:admin@localhost}
}

http://{$DOMAIN:localhost} {
	encode gzip zstd
	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
