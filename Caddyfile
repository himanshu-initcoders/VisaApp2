{
	email {$CADDY_EMAIL:hello@viserv.in}
}

# Apex + www (Caddy gets Let's Encrypt certs after DNS points here)
viserv.in, www.viserv.in {
	encode gzip zstd
	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
