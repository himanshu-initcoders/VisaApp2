# =============================================================================
# Production env for Hostinger VPS (/opt/visa/.env)
# Copy: cp deploy/env.production.example /opt/visa/.env
# Never commit the real .env
# =============================================================================

# --- Public site -------------------------------------------------------------
# After DNS A records point at the VPS (leave Vercel):
DOMAIN=viserv.in
CADDY_EMAIL=hello@viserv.in
NEXTAUTH_URL=https://viserv.in
AUTH_TRUST_HOST=true
NODE_ENV=production

# --- Postgres on the HOST (not Docker) ---------------------------------------
POSTGRES_USER=visa
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=visa_db
# App + migrate containers reach the host via host.docker.internal (compose extra_hosts)
DATABASE_URL=postgresql://visa:change-me-strong-password@host.docker.internal:5432/visa_db

# One-time Neon → Postgres transfer only (remove after cutover)
# NEON_DATABASE_URL=postgresql://neondb_owner:...@ep-....neon.tech/neondb?sslmode=require

# Host docker group GID for Jenkins socket access: getent group docker | cut -d: -f3
DOCKER_GID=999

# --- Auth --------------------------------------------------------------------
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
CREDENTIALS_ENCRYPTION_KEY=generate-with-node-randomBytes-32-base64
AUTH_OTP_MODE=whatsapp
# OTP_PEPPER=

# --- Uploads (keep S3 in production; DB moves off Neon, files stay on S3) ----
UPLOAD_PROVIDER=s3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# --- Email (Zoho CPaaS) ------------------------------------------------------
ZOHO_CPAAS_SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
ADMIN_NOTIFY_EMAIL=admin@example.com

# --- WhatsApp (Twilio) -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+91XXXXXXXXXX
TWILIO_WA_SID_USER_WELCOME=
TWILIO_WA_SID_REVIEWER_WELCOME=
TWILIO_WA_SID_VISA_SUBMITTED_APPLICANT=
TWILIO_WA_SID_VISA_SUBMITTED_ADMIN=
TWILIO_WA_SID_REVIEWER_ASSIGNED=
TWILIO_WA_SID_CORRECTION_REQUESTED=
TWILIO_WA_SID_CORRECTION_RESUBMITTED=
TWILIO_WA_SID_NEW_COMMENT_APPLICANT=
TWILIO_WA_SID_NEW_COMMENT_STAFF=
TWILIO_WA_SID_STATUS_CHANGED_APPLICANT=
TWILIO_WA_SID_STATUS_CHANGED_STAFF=
TWILIO_WA_SID_STATUS_APPROVED_WITH_DOCUMENT=
TWILIO_WA_SID_LOGIN_OTP=
TWILIO_WA_SID_PASSPORT_SUBMITTED_APPLICANT=
TWILIO_WA_SID_PASSPORT_SUBMITTED_ADMIN=
TWILIO_WA_SID_PASSPORT_REVIEWER_ASSIGNED=
TWILIO_WA_SID_PASSPORT_CORRECTION_REQUESTED=
TWILIO_WA_SID_PASSPORT_CORRECTION_RESUBMITTED=
TWILIO_WA_SID_PASSPORT_NEW_COMMENT_APPLICANT=
TWILIO_WA_SID_PASSPORT_NEW_COMMENT_STAFF=
TWILIO_WA_SID_PASSPORT_STATUS_CHANGED_APPLICANT=
TWILIO_WA_SID_PASSPORT_STATUS_CHANGED_STAFF=

# --- Razorpay ----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- TinyMCE -----------------------------------------------------------------
NEXT_PUBLIC_TINYMCE_API_KEY=
