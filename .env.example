# =============================================================================
# VISA & PASSPORT SERVICE PLATFORM - Environment Variables
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/visa_db

# =============================================================================
# NEXTAUTH
# =============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-random-secret-here-use-openssl-rand-base64-32

# Applicant mobile OTP: mock (always accept) | sms (not wired yet)
AUTH_OTP_MODE=mock

# =============================================================================
# FILE UPLOADS - Choose Provider
# =============================================================================
# Options: local, s3, cloudinary
UPLOAD_PROVIDER=local

# -----------------------------------------------------------------------------
# Local Filesystem Upload (UPLOAD_PROVIDER=local)
# -----------------------------------------------------------------------------
# Directory where files are stored (relative to project root)
LOCAL_UPLOAD_DIR=public/uploads

# Public URL base for accessing files
LOCAL_UPLOAD_URL=/uploads

# -----------------------------------------------------------------------------
# AWS S3 Upload (UPLOAD_PROVIDER=s3)
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=your-bucket-name

# -----------------------------------------------------------------------------
# Cloudinary Upload (UPLOAD_PROVIDER=cloudinary)
# -----------------------------------------------------------------------------
# Note: Requires npm install cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# EMAIL (Gmail SMTP via Nodemailer)
# =============================================================================
# Gmail account that sends mail. Use an app password, not the account password.
# https://support.google.com/accounts/answer/185833
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Optional. Defaults to GMAIL_USER. Shown as "Viserv <address>".
EMAIL_FROM=your-gmail@gmail.com
# Single inbox for new visa request notices.
ADMIN_NOTIFY_EMAIL=admin@yourapp.com

# =============================================================================
# RAZORPAY
# =============================================================================
# Key id is public and is also returned to Checkout.js. Never expose the secret.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# =============================================================================
# DEVELOPMENT
# =============================================================================
NODE_ENV=development

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit this file with real credentials
# 2. Copy this to .env and fill in your values
# 3. Add .env to .gitignore
# 4. For local development, use UPLOAD_PROVIDER=local
# 5. For production, use UPLOAD_PROVIDER=s3 or cloudinary
# 6. Generate NEXTAUTH_SECRET with: openssl rand -base64 32
