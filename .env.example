# =============================================================================
# VISA & PASSPORT SERVICE PLATFORM - Environment Variables
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/visa_db

# =============================================================================
# NEXTAUTH
# =============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-random-secret-here-use-openssl-rand-base64-32

# 32-byte key, base64. Encrypts portal passwords on visa and passport applications.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=generate-with-openssl-or-node-randomBytes-32

# Applicant mobile OTP: mock (always accept) | sms (not wired yet)
AUTH_OTP_MODE=mock

# =============================================================================
# FILE UPLOADS - Choose Provider
# =============================================================================
# Options: local, s3, cloudinary
UPLOAD_PROVIDER=local

# -----------------------------------------------------------------------------
# Local Filesystem Upload (UPLOAD_PROVIDER=local)
# -----------------------------------------------------------------------------
# Directory where files are stored (relative to project root)
LOCAL_UPLOAD_DIR=public/uploads

# Public URL base for accessing files
LOCAL_UPLOAD_URL=/uploads

# -----------------------------------------------------------------------------
# AWS S3 Upload (UPLOAD_PROVIDER=s3)
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=your-bucket-name

# -----------------------------------------------------------------------------
# Cloudinary Upload (UPLOAD_PROVIDER=cloudinary)
# -----------------------------------------------------------------------------
# Note: Requires npm install cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# EMAIL (Zoho CPaaS SMTP via Nodemailer)
# =============================================================================
# Agents → Agent → SMTP/API → SMTP tab: https://www.zoho.com/cpaas/help/smtp-home.html
# Host defaults to smtp.zeptomail.com. Username defaults to emailapikey.
# Quote the password — tokens often contain +, /, and trailing =.
ZOHO_CPAAS_SMTP_PASSWORD="your-smtp-password-from-agent"
# Optional: ZOHO_CPAAS_SMTP_USER=emailapikey
# Optional: ZOHO_CPAAS_SMTP_HOST=smtp.zeptomail.com
# Must be on a domain verified and assigned to that SAME Agent.
EMAIL_FROM=noreply@yourdomain.com
# Single inbox for new visa request notices.
ADMIN_NOTIFY_EMAIL=admin@yourapp.com

# =============================================================================
# RAZORPAY
# =============================================================================
# Key id is public and is also returned to Checkout.js. Never expose the secret.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# =============================================================================
# DEVELOPMENT
# =============================================================================
NODE_ENV=development

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit this file with real credentials
# 2. Copy this to .env and fill in your values
# 3. Add .env to .gitignore
# 4. For local development, use UPLOAD_PROVIDER=local
# 5. For production, use UPLOAD_PROVIDER=s3 or cloudinary
# 6. Generate NEXTAUTH_SECRET with: openssl rand -base64 32
